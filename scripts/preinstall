#!/bin/bash
# Pre-install script for ClipStack.pkg
# Runs before installation to clean up old versions
# This ensures clean upgrades without conflicts

# Exit on error
set -e

echo "ClipStack Pre-Install: Cleaning up old installation..."

# 1. Kill any running instances
pkill -9 ClipStack 2>/dev/null || true
echo "  ✓ Stopped running instances"

# 2. Remove old application bundle
if [ -d "/Applications/ClipStack.app" ]; then
    rm -rf "/Applications/ClipStack.app"
    echo "  ✓ Removed old application bundle"
fi

if [ -d "$HOME/Applications/ClipStack.app" ]; then
    rm -rf "$HOME/Applications/ClipStack.app"
    echo "  ✓ Removed user application bundle"
fi

# 3. Clear quarantine attributes from any cached files
# This prevents permission issues
echo "  ✓ Preparing for clean installation"

# 4. Wait for file system sync
sleep 0.5

echo "✓ Pre-install cleanup complete"
exit 0
